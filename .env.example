# Discord Developer Portal -> Application
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
# Leave empty for global/public commands. Set only for instant test-server updates.
DISCORD_GUILD_ID=
# Optional: multiple servers whose guild commands should be cleared to prevent duplicates.
# Comma-separated. Include the test server above if you have used --guild.
DISCORD_GUILD_IDS=

# Supabase public/read-only keys from the GearCore project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Store links and support details.
STORE_URL=https://www.gearcore.store/
SUPPORT_EMAIL=gearcorebyfl33@gmail.com
TELEGRAM_USERNAME=Torn_Visal
PROMO_CODE=WELCOME10
PREORDER_DAYS=7-10 days

# Optional initial Discord destinations. The dashboard can change these at runtime.
SUPPORT_CHANNEL_ID=
ANNOUNCE_CHANNEL_ID=
WELCOME_CHANNEL_ID=
WELCOME_ROLE_ID=

# Local control API used by the web dashboard. Keep the token private.
CONTROL_PORT=8787
CONTROL_API_TOKEN=generate-a-long-random-string
