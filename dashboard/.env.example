DASHBOARD_PASSWORD=change-this-password
DASHBOARD_SESSION_SECRET=generate-a-long-random-string
# Use http://127.0.0.1:8787 when bot and dashboard run in the same deployment.
# If the dashboard is on Vercel or another server, use the bot control API's HTTPS URL.
BOT_CONTROL_URL=http://127.0.0.1:8787
BOT_CONTROL_TOKEN=copy-from-bot-.env
