{
  "name": "gearcore-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord bot for GearCore.Store",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "deploy:commands": "tsx src/scripts/deploy-commands.ts",
    "clear:guild": "tsx src/scripts/deploy-commands.ts --clear-guild",
    "clear:global": "tsx src/scripts/deploy-commands.ts --clear-global"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@supabase/supabase-js": "^2.49.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
